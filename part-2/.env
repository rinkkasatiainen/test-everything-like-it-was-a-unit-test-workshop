# Full-stack profile: the host runs against the Postgres + RabbitMQ brought up by `npm run db:up`
# (the compose file bundled inside the cfb-local-host package). Postgres is seeded on first start
# from that package's schema.sql + seed.sql. Login goes through the local `peeps` table.
#
# These are LOCAL DEV credentials for a throwaway container — not secrets.
CFB_PROFILE=local
CFB_DB=postgres
CFB_DEMO_PROFILE=pg-rabbit
DATABASE_URL=postgres://cfb:cfb-local-dev@localhost:55432/cfb_local
PG_SCHEMA=event_store
RABBIT_URL=amqp://localhost
CFB_EXCHANGE=cfb-session-scheduling-events
RELAY_INTERVAL_MS=1000
STATIC_ROOT=public
PORT=3001
APP_BASE_URL=http://localhost:3001

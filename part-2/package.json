{
  "name": "@rinkkasatiainen/test-everything-like-it-was-a-unit-test-workshop",
  "version": "1.0.0",
  "description": "A working repo for the workshop titled 'Test everything like (it was) a unit test'",
  "main": "index.js",
  "scripts": {
    "ui:build": "node scripts/prepare-ui.mjs",
    "start": "npm run ui:build && node scripts/start.mjs .env.memory",
    "start:pg": "npm run db:up && npm run ui:build && node scripts/start.mjs .env",
    "db:up": "node ../node_modules/@rinkkasatiainen/cfb-local-host/bin/db-compose.mjs up -d --wait",
    "db:down": "node ../node_modules/@rinkkasatiainen/cfb-local-host/bin/db-compose.mjs down",
    "db:reset": "node ../node_modules/@rinkkasatiainen/cfb-local-host/bin/db-compose.mjs down -v && npm run db:up",
    "clean": "rm -rf public",
    "test": "../node_modules/.bin/mocha testing/test/**/*.test.js",
    "test:component": "../node_modules/.bin/mocha 'testing/test/component/**/*.test.js' 'testing/test/component-integration/**/*.test.js'",
    "test:component-integration": "../node_modules/.bin/mocha 'testing/test/component-integration/**/*.test.js'",
    "test:contract": "../node_modules/.bin/mocha 'testing/test/contract/**/*.test.js'",
    "test:resilience": "../node_modules/.bin/mocha 'testing/test/resilience/**/*.test.js'",
    "test:integration": "../node_modules/.bin/mocha 'testing/test/integration/**/*.test.js'",
    "test:e2e": "../node_modules/.bin/mocha 'testing/test/e2e/**/*.test.js'",
    "test:all": "../node_modules/.bin/mocha 'testing/test/**/*.test.js'",
    "lint": "../node_modules/.bin/eslint -- src test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinkkasatiainen/test-everything-like-it-was-a-unit-test-workshop.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rinkkasatiainen/test-everything-like-it-was-a-unit-test-workshop/issues"
  },
  "homepage": "https://github.com/rinkkasatiainen/test-everything-like-it-was-a-unit-test-workshop#readme",
  "dependencies": {
    "@rinkkasatiainen/cfb-local-host": "^1.0.0"
  },
  "devDependencies": {
    "@rinkkasatiainen/cfb-eslint": "^1.0.1",
    "@rinkkasatiainen/cfb-schema-matcher": "^1.0.0",
    "@rinkkasatiainen/cfb-server-shell": "^1.0.0",
    "@rinkkasatiainen/cfb-session-discovery-contracts": "^1.0.0",
    "@rinkkasatiainen/cfb-session-proposal-contracts": "^1.0.0",
    "@rinkkasatiainen/cfb-session-scheduling-contracts": "^1.0.0",
    "@rinkkasatiainen/cfb-testing-utils": "^1.0.0",
    "@rinkkasatiainen/cfb-event-sourcing-bus-rabbitmq": "^1.0.0",
    "@rinkkasatiainen/cfb-event-sourcing-relay": "^1.0.0",
    "@rinkkasatiainen/cfb-event-sourcing-testing": "^1.0.0",
    "@rinkkasatiainen/cfb-event-sourcing-tracking": "^1.0.0",
    "@rinkkasatiainen/cfb-functional": "^1.1.0",
    "@rinkkasatiainen/cfb-session-discovery-node-js": "^0.9.5",
    "@rinkkasatiainen/cfb-session-proposal-core": "^0.9.5",
    "@rinkkasatiainen/cfb-session-proposal-node-js": "^0.9.5",
    "@rinkkasatiainen/cfb-session-scheduling-node-js": "^0.9.6",
    "chai": "^5.1.0",
    "mocha": "^10.4.0",
    "supertest": "^7.0.0",
    "ws": "^8.18.0"
  }
}

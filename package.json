{
  "name": "@rinkkasatiainen/test-everything-like-it-was-a-unit-test-workshop",
  "version": "1.0.0",
  "description": "A working repo for the workshop titled 'Test everything like (it was) a unit test'",
  "main": "index.js",
  "scripts": {
    "ui:build": "node scripts/prepare-ui.mjs",
    "start": "npm run ui:build && node scripts/start.mjs .env.memory",
    "start:pg": "npm run db:up && npm run ui:build && node scripts/start.mjs .env",
    "db:up": "node node_modules/@rinkkasatiainen/cfb-local-host/bin/db-compose.mjs up -d --wait",
    "db:down": "node node_modules/@rinkkasatiainen/cfb-local-host/bin/db-compose.mjs down",
    "db:reset": "node node_modules/@rinkkasatiainen/cfb-local-host/bin/db-compose.mjs down -v && npm run db:up",
    "clean": "rm -rf public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinkkasatiainen/test-everything-like-it-was-a-unit-test-workshop.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rinkkasatiainen/test-everything-like-it-was-a-unit-test-workshop/issues"
  },
  "homepage": "https://github.com/rinkkasatiainen/test-everything-like-it-was-a-unit-test-workshop#readme",
  "dependencies": {
    "@rinkkasatiainen/cfb-local-host": "^1.0.0"
  }
}

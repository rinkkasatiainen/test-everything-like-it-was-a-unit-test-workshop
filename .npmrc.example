# Copy to .npmrc and provide a token. The @rinkkasatiainen packages live in GitHub Packages,
# which needs a GitHub token with `read:packages` to install.
#
#   cp .npmrc.example .npmrc
#   export NODE_AUTH_TOKEN=ghp_your_read_packages_token   # or paste it below instead of the var
#
# Prefer the env var over a literal token so no secret is ever written to a file that might be
# committed.
@rinkkasatiainen:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
